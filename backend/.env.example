# Business Manager AI OS — Environment Configuration
# Copy this file to .env and fill in your values.

# ── Database ──────────────────────────────────────────────────────────────
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///./business_manager.db
# PostgreSQL (production):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/business_manager

# ── Security ──────────────────────────────────────────────────────────────
# CHANGE THIS in production! Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bm-change-this-secret-in-production-2026
ACCESS_TOKEN_MINUTES=43200

# ── Google Gemini AI ──────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=25

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * for development only.
CORS_ORIGINS=*

# ── App ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development
